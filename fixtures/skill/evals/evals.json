        "button"
      ],
      "absent": [
        "table"
      ],
      "avoid": [
        "lint/untitled",
        "lint/primary-twice"
      ],
      "actions": [
        "save"
      ]
    },
    {
      "id": "delete-project",
      "prompt": "A project page with a button that deletes the project for good.",
      "kinds": [
        "button"
      ],
      "avoid": [
        "lint/destructive-unconfirmed",
        "lint/action-no-id"
      ],
      "actions": [
        "delete-project"
      ]
    },
    {
      "id": "empty-inbox",
      "prompt": "An inbox that has no messages yet.",
      "kinds": [
        "list",
        "text"
      ],
      "avoid": [
        "lint/empty-state",
        "lint/untitled"
      ]
    },
    {
      "id": "sign-up",
      "prompt": "A sign-up form with a name, an email and a password field, sent as sign-up.",
      "kinds": [
        "form"
      ],
      "absent": [
        "table"
      ],
      "actions": [
        "sign-up"
      ]
    },
    {
      "id": "agent-thread",
      "prompt": "A chat thread where the agent is still writing its answer.",
      "kinds": [
        "message",
        "prose"
      ],
      "avoid": [
        "lint/stream-no-id"
      ]
    },
    {
      "id": "deploy-card",
      "prompt": "A deploy card with a ship and a stage button, ship the main one.",
