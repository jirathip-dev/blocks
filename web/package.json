{
  "name": "blocks-web",
  "private": true,
  "type": "module",
  "description": "The generated TS types of the blocks schema, the stream client and the patcher; strict tsc, lint.mjs and node --test hold them",
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit",
    "lint": "node --no-warnings lint.mjs src react/src",
    "test": "node --no-warnings --test test/*.test.ts test/kind/*.test.ts && node --no-warnings --test test/alone/*.test.ts",
    "shot": "node --no-warnings shot/cli.ts",
    "test:react": "node --no-warnings --test react/test/*.test.ts",
    "test:client": "node --no-warnings --test test/client/*.test.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2"
  }
}
