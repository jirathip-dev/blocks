{
  "name": "blocks-web",
  "private": true,
  "type": "module",
  "description": "The generated TS types of the blocks schema, the stream client and the patcher; strict tsc, lint.mjs and node --test hold them",
  "scripts": {
    "build": "esbuild src/shell.ts --bundle --format=esm --minify --legal-comments=none --outfile=dist/blocks.js && esbuild src/blocks.css --minify --outfile=dist/blocks.css",
    "check": "tsc --noEmit",
    "lint": "node --no-warnings lint.mjs src",
    "test": "node --no-warnings --test test/*.test.ts"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
