{
  "name": "@jirathip-dev/blocks",
  "version": "2.2.0",
  "description": "The framework-neutral blocks core (generated types, builders, check, the evaluator, tree tests, choose and the scheme CSS writer), its React adapter, and the HTML renderer and shell a page mounts",
  "keywords": [
    "ui",
    "server-driven-ui",
    "renderer",
    "react",
    "design-system",
    "blocks"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jirathip-dev/blocks.git"
  },
  "homepage": "https://github.com/jirathip-dev/blocks/blob/main/docs/consume.md",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./web/dist/types/src/core/index.d.ts",
      "default": "./web/dist/core.js"
    },
    "./react": {
      "types": "./web/dist/types/react/src/index.d.ts",
      "default": "./web/dist/react.js"
    },
    "./shell": {
      "types": "./web/dist/types/src/shell.d.ts",
      "default": "./web/dist/blocks.js"
    },
    "./blocks.css": "./web/dist/blocks.scoped.css"
  },
  "files": ["web/dist/core.js", "web/dist/react.js", "web/dist/blocks.js", "web/dist/import.js", "web/dist/scan.js", "web/dist/blocks.css", "web/dist/blocks.scoped.css", "web/dist/types"],
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
